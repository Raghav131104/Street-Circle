{
  "name": "streetcircle-backend",
  "version": "1.0.0",
  "private": true,
  "description": "StreetCircle modular monolith API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "typecheck": "node --check src/app.js && node --check src/server.js",
    "test": "node --test",
    "test:integration": "node --test tests/integration/health.test.js",
    "build": "node --check src/app.js && node --check src/server.js"
  },
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "mongoose": "^9.9.1",
    "multer": "^2.0.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  }
}
